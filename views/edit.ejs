<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> - Sistem Manajemen Mahasiswa</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- CSS -->
   <link rel="stylesheet" href="/style/edit.css">

    <link rel="icon" href="/image/mortarboard.png" type="image/png">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <!-- HEADER / NAVBAR (TIDAK DIRUBAH) -->
  <header class="gradient-header shadow-sm sticky-top">
    <nav class="navbar navbar-expand-md">
      <div class="container-fluid px-5">
        <a class="navbar-brand d-flex align-items-center text-white text-decoration-none" href="#">
          <div class="bg-primary-foreground-20 p-1 rounded-3 me-3 d-flex align-items-center justify-content-center">
            <i class="bi bi-mortarboard-fill fs-4"></i>
          </div>
          <div>
            <h1 class="h5 mb-0 fw-bold text-primary-foreground">Sistem Manajemen Mahasiswa</h1>
            <p class="mb-0 small text-white opacity-75">STMIK KAPUTAMA</p>
          </div>
        </a>
        <div class="d-none d-md-flex align-items-center text-white small">
          <span class="me-3 opacity-90">Admin Panel</span>
          <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-foreground-20" style="width: 2rem; height: 2rem; font-size: 0.8rem;">
            AD
          </div>
        </div>
      </div>
    </nav>
  </header>

  <!-- MAIN CONTENT -->
  <main class="container py-4 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-xl-7">

        <!-- Back Button -->
        <a href="/mahasiswa" class="btn-back mb-3">
          <i class="bi bi-arrow-left me-2"></i>
          Kembali ke Daftar Mahasiswa
        </a>

        <!-- Card Edit -->
        <div class="card card-custom animate-fade-in">
          <div class="card-header-custom">
            <h2 class="h5 mb-1 fw-semibold text-dark">Edit Data Mahasiswa</h2>
            <p class="text-muted small mb-0">Perbarui informasi mahasiswa di bawah ini</p>
          </div>

          <div class="card-body p-4">
            <form action="/mahasiswa/edit/<%= mahasiswa.nim %>" method="post">

              <div class="row g-4">
                <!-- NIM -->
                <div class="col-md-6">
                  <label for="nim" class="form-label">
                    NIM <span class="required-mark">*</span>
                  </label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="nim" 
                    name="nim" 
                    value="<%= mahasiswa.nim %>"
                    placeholder="Contoh: 22451010"
                    maxlength="8"
                    required>
                </div>

                <!-- Nama Lengkap -->
                <div class="col-md-6">
                  <label for="nama" class="form-label">
                    Nama Lengkap <span class="required-mark">*</span>
                  </label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="nama" 
                    name="nama" 
                    value="<%= mahasiswa.nama %>"
                    placeholder="Contoh: Andi Pratama"
                    required>
                </div>

                <!-- Jurusan -->
                <div class="col-md-6">
                  <label for="jurusan" class="form-label">
                    Jurusan <span class="required-mark">*</span>
                  </label>
                  <select name="jurusan" id="jurusan" class="form-select" required>
                    <option value="" disabled>Pilih jurusan</option>
                    <% listOfMajors.forEach(jurusan => { %>
                      <option value="<%= jurusan %>" 
                              <%= mahasiswa.jurusan === jurusan ? 'selected' : '' %>>
                        <%= jurusan %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <!-- Angkatan -->
                <div class="col-md-6">
                  <label for="angkatan" class="form-label">
                    Angkatan <span class="required-mark">*</span>
                  </label>
                  <select name="angkatan" id="angkatan" class="form-select" required>
                    <% for(let year = new Date().getFullYear(); year >= new Date().getFullYear() - 5; year--) { %>
                      <option value="<%= year %>" <%= mahasiswa.angkatan === year ? 'selected' : '' %>>
                        <%= year %>
                      </option>
                    <% } %>
                  </select>
                </div>

                <!-- Alamat -->
                <div class="col-12">
                  <label for="alamat" class="form-label">
                    Alamat <span class="required-mark">*</span>
                  </label>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="alamat" 
                    name="alamat" 
                    value="<%= mahasiswa.alamat %>"
                    placeholder="Contoh: Jl. Merdeka No. 45, Jakarta Selatan"
                    required>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="d-flex justify-content-end gap-2 mt-4 pt-2">
                <a href="/mahasiswa" class="btn btn-cancel">
                  <i class="bi bi-x me-1"></i>
                  Batal
                </a>
                <button type="submit" class="btn btn-success-custom">
                  Simpan Perubahan
                </button>
              </div>

            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- FOOTER (TIDAK DIRUBAH) -->
  <footer class="border-top mt-auto py-4 bg-white">
    <div class="container">
      <p class="text-center text-muted mb-0 small">
        © <%= new Date().getFullYear() %> Sistem Manajemen Mahasiswa - STMIK KAPUTAMA
      </p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>