<!-- Stats Cards -->
<div class="row g-4 mb-5">
  <% 
    const stats = [
      { 
        label: "Total Mahasiswa", 
        value: totalStudents, 
        icon: "bi-people-fill", 
        color: "bg-primary bg-opacity-10 text-primary" 
      },
      { 
        label: "Program Studi", 
        value: totalJurusan, 
        icon: "bi-book-fill", 
        color: "bg-info bg-opacity-10 text-info" 
      },
      { 
        label: "Mahasiswa Aktif", 
        value: totalStudents, 
        icon: "bi-mortarboard-fill", 
        color: "bg-success bg-opacity-10 text-success" 
      },
      { 
        label: "Registrasi Bulan Ini", 
        value: 3, 
        icon: "bi-person-plus-fill", 
        color: "bg-warning bg-opacity-10 text-warning" 
      }
    ];
  %>
  
  <% stats.forEach((stat, index) => { %>
    <div class="col-12 col-sm-6 col-lg-3 ">
      <div class="card border-0 shadow-sm h-100 hover-shadow stat-card-<%= index %>">
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-4">
            <div class="p-2 rounded-3 <%= stat.color %>">
              <i class="bi <%= stat.icon %> fs-4"></i>
            </div>
            <div>
              <h3 class="mb-1 fw-bold text-dark fs-4"><%= stat.value %></h3>
              <p class="mb-0 text-muted small"><%= stat.label %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .stat-card-0 { animation: fadeInUp 0.6s ease-out both; }
  .stat-card-1 { animation: fadeInUp 0.7s ease-out both; }
  .stat-card-2 { animation: fadeInUp 0.8s ease-out both; }
  .stat-card-3 { animation: fadeInUp 0.9s ease-out both; }
  
  .hover-shadow {
    transition: all 0.3s ease;
  }
  
  .hover-shadow:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
  }
</style>