<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Sistem Manajemen Mahasiswa</title>
    <!-- Bootstrap 5.3 (update dari 5.0.2) -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
   
    <!-- CSS -->
     <link rel="stylesheet" href="/style/index.css">

   <link rel="icon" href="/image/mortarboard.png" type="image/png">
  </head>
  <body class="bg-light">
    <!-- Header/Navbar -->
    <header class="gradient-header shadow-sm sticky-top">
      <nav class="navbar navbar-expand-md">
        <div class="container-fluid px-3">
          <!-- py-3 untuk tinggi mirip h-16 Tailwind -->
          <!-- Logo + Judul -->
          <a
            class="navbar-brand d-flex align-items-center text-white text-decoration-none"
            href="#"
          >
            <div
              class="bg-primary-foreground-20 p-1 rounded-3 me-3 d-flex align-items-center justify-content-center"
            >
              <i class="bi bi-mortarboard-fill fs-4"></i>
            </div>
            <div>
              <h1 class="h5 mb-0 fw-bold text-primary-foreground">
                Sistem Manajemen Mahasiswa
              </h1>
              <p class="mb-0 small text-white opacity-75">STMIK KAPUTAMA</p>
            </div>
          </a>

          <!-- User Info (desktop only) -->
          <div class="d-none d-md-flex align-items-center text-white small">
            <span class="me-3 opacity-90">Admin Panel</span>
            <div
              class="d-flex align-items-center justify-content-center rounded-circle bg-primary-foreground-20 text-xs fw-medium"
              style="width: 2rem; height: 2rem; font-size: 0.8rem"
            >
              AD
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="container min-vh-100 px-4 py-5">
      <!-- Hero Section -->
      <div class="mb-3">
        <h1 class="fs-3 fw-bold text-dark mb-2"><%= title %></h1>
        <p class="text-muted mb-0">
          Kelola data mahasiswa dengan mudah dan efisien
        </p>
      </div>

      <!-- Hitung statistik -->
      <% const totalStudents = mahasiswa.length; const totalJurusan = [...new
      Set(mahasiswa.map(m => m.jurusan))].length; %>

      <!-- Include Stats Card -->
      <%- include('partials/stats-card', { totalStudents, totalJurusan }) %>
      <div class="mb-4">
        <h3 class="fs-5 fw-semibold">Daftar Mahasiswa</h3>
        <p class="fw-3">
          Menampilkan mahasiswa <%= mahasiswa.length %> terdaftar
        </p>
      </div>
      <!-- Tabel Mahasiswa -->
      <div class="card shadow-sm mb-5">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>No</th>
                  <th>NIM</th>
                  <th>Nama</th>
                  <th>Jurusan</th>
                  <th>Angkatan</th>
                  <th>Alamat</th>
                  <th class="text-center">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% mahasiswa.forEach((mhs, i) => { %>
                <tr>
                  <th><%= i + 1 %></th>
                  <td><strong><%= mhs.nim %></strong></td>
                  <td><%= mhs.nama %></td>
                  <td><%= mhs.jurusan %></td>
                  <td>
                    <span class="badge bg-light text-primary"
                      ><%= mhs.angkatan %></span
                    >
                  </td>
                  <td><%= mhs.alamat %></td>
                  <td class="text-center">
                    <a
                      href="/mahasiswa/edit/<%= mhs.nim %>"
                      class="btn btn-warning btn-sm "
                      ><i class="bi bi-pencil-square"></i>Edit</a
                    >
                    <form
                      action="/mahasiswa/hapus/<%= mhs.nim %>"
                      method="post"
                      style="display: inline"
                      onsubmit="return confirm('Yakin hapus <%= mhs.nama %> (NIM: <%= mhs.nim %>)?');"
                    >
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

     <!-- Form Tambah Mahasiswa - Collapsible -->
        <div class="card card-custom animate-fade-in">
          
          <!-- Button Tambah (Toggle Collapse) -->
          <div class="p-4">
            <button 
              class="btn-add-collapsed" 
              type="button" 
              data-bs-toggle="collapse" 
              data-bs-target="#formTambah" 
              aria-expanded="false" 
              aria-controls="formTambah">
              <i class="bi bi-plus-lg"></i>
              Tambah Mahasiswa Baru
              <i class="bi bi-chevron-down ms-auto toggle-icon"></i>
            </button>
          </div>

          <!-- Collapsible Form Content -->
          <div class="collapse" id="formTambah">
            <div class="card-header-border bg-light p-4">
              <button 
                class="card-header-collapsible" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#formTambah">
                <h3>Form Tambah Mahasiswa Baru</h3>
                <i class="bi bi-chevron-up toggle-icon"></i>
              </button>
            </div>

            <div class="card-body p-4">
              <form action="/mahasiswa/tambah" method="post">
                <div class="row g-4">
                  <!-- NIM -->
                  <div class="col-md-6">
                    <label for="nim" class="form-label">
                      NIM <span class="required-mark">*</span>
                    </label>
                    <input 
                      type="text" 
                      class="form-control" 
                      id="nim" 
                      name="nim" 
                      placeholder="Contoh: 22451010"
                      maxlength="8"
                      required>
                  </div>

                  <!-- Nama Lengkap -->
                  <div class="col-md-6">
                    <label for="nama" class="form-label">
                      Nama Lengkap <span class="required-mark">*</span>
                    </label>
                    <input 
                      type="text" 
                      class="form-control" 
                      id="nama" 
                      name="nama" 
                      placeholder="Contoh: Andi Pratama"
                      required>
                  </div>

                  <!-- Jurusan -->
                  <div class="col-md-6">
                    <label for="jurusan" class="form-label">
                      Jurusan <span class="required-mark">*</span>
                    </label>
                    <select name="jurusan" id="jurusan" class="form-select" required>
                      <option value="" disabled selected>Pilih jurusan</option>
                      <% listOfMajors.forEach(jurusan => { %>
                        <option value="<%= jurusan %>"><%= jurusan %></option>
                      <% }) %>
                    </select>
                  </div>

                  <!-- Angkatan -->
                  <div class="col-md-6">
                    <label for="angkatan" class="form-label">
                      Angkatan <span class="required-mark">*</span>
                    </label>
                    <select name="angkatan" id="angkatan" class="form-select" required>
                      <% for(let year = new Date().getFullYear(); year >= new Date().getFullYear() - 5; year--) { %>
                        <option value="<%= year %>" <%= year === new Date().getFullYear() ? 'selected' : '' %>>
                          <%= year %>
                        </option>
                      <% } %>
                    </select>
                  </div>

                  <!-- Alamat -->
                  <div class="col-12">
                    <label for="alamat" class="form-label">
                      Alamat <span class="required-mark">*</span>
                    </label>
                    <input 
                      type="text" 
                      class="form-control" 
                      id="alamat" 
                      name="alamat" 
                      placeholder="Contoh: Jl. Merdeka No. 45, Jakarta Selatan"
                      required>
                  </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-2">
                  <button 
                    type="button" 
                    class="btn btn-cancel" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#formTambah">
                    <i class="bi bi-x me-1"></i>
                    Batal
                  </button>
                  <button type="submit" class="btn btn-primary">
                    Tambah Mahasiswa
                  </button>
                </div>
              </form>
            </div>
          </div>
    </main>

    <footer class="border-top mt-5 py-4 bg-light">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <p class="text-center text-muted mb-0 small">
              © 2026 Sistem Manajemen Mahasiswa - STMIK KAPUTAMA
            </p>
          </div>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
